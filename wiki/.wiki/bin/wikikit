#!/usr/bin/env python3
"""wikikit - maintenance toolkit for an LLM Wiki / Knowledge Graph.

A single-file, dependency-free (Python standard library only) command line tool
that gives the LLM Wiki skills testable, observable operations over a wiki of
markdown files.

Every subcommand:
  * takes explicit inputs (a wiki directory, a query, a source, ...)
  * supports --json for machine-readable output on stdout
  * exits non-zero when it detects a hard failure (validation errors, drift)

Run `wikikit --help` or `wikikit <command> --help` for usage.
The full schema is documented in .wiki/schema/SCHEMA.md of an initialized wiki.
"""

from __future__ import annotations

import argparse
import datetime as _dt
import json
import math
import os
import re
import shutil
import stat
import sys
import tempfile

# --------------------------------------------------------------------------- #
# Wiki layout constants
# --------------------------------------------------------------------------- #

PAGES_DIR = "pages"
SOURCES_DIR = "sources"
INDEX_FILE = "index.md"
LOG_FILE = "log.md"
AGENTS_FILE = "AGENTS.md"
TOOL_DIR = ".wiki"

# page type -> sub directory under pages/
TYPE_DIRS = {
    "entity": "entities",
    "concept": "concepts",
    "source": "sources",
    "topic": "topics",
    "analysis": "analyses",
}
# single-file page types (relative path under the wiki root)
SINGLETON_PAGES = {"overview": os.path.join(PAGES_DIR, "overview.md")}

VALID_TYPES = set(TYPE_DIRS) | set(SINGLETON_PAGES)
VALID_STATUS = {"active", "stale", "draft"}

# index.md section ordering and headings
INDEX_SECTIONS = [
    ("overview", "Overview"),
    ("entity", "Entities"),
    ("concept", "Concepts"),
    ("topic", "Topics"),
    ("analysis", "Analyses"),
    ("source", "Sources"),
]

STOPWORDS = {
    "the", "a", "an", "and", "or", "of", "to", "in", "on", "for", "is", "are",
    "was", "were", "be", "with", "as", "by", "at", "it", "this", "that", "from",
    "we", "you", "i", "he", "she", "they", "but", "not", "if", "then", "than",
}

TITLE_BOOST = 3
STALE_DAYS = 180
BM25_K1 = 1.5
BM25_B = 0.75

WIKILINK_RE = re.compile(r"\[\[([^\]\|#]+)(?:#[^\]\|]+)?(?:\|[^\]]*)?\]\]")
TOKEN_RE = re.compile(r"[a-z0-9]+")
DATE_RE = re.compile(r"^\d{4}-\d{2}-\d{2}$")
LOG_ENTRY_RE = re.compile(r"^## \[")


# --------------------------------------------------------------------------- #
# Parsing / text helpers
# --------------------------------------------------------------------------- #

def today() -> str:
    return _dt.date.today().isoformat()


def slugify(text: str) -> str:
    text = text.strip().lower()
    text = re.sub(r"[^a-z0-9]+", "-", text)
    return text.strip("-")


def _unquote(value: str) -> str:
    if len(value) >= 2 and value[0] == value[-1] and value[0] in ("'", '"'):
        return value[1:-1]
    return value


def parse_frontmatter(text: str):
    """Return (frontmatter_dict, body). Tolerant subset-of-YAML parser.

    Supports `key: scalar`, inline lists `key: [a, b]`, and block lists:
        key:
          - a
          - b
    """
    if not text.startswith("---"):
        return {}, text
    lines = text.split("\n")
    end = None
    for i in range(1, len(lines)):
        if lines[i].strip() == "---":
            end = i
            break
    if end is None:
        return {}, text
    fm_lines = lines[1:end]
    body = "\n".join(lines[end + 1:])
    data: dict = {}
    key = None
    for raw in fm_lines:
        if not raw.strip() or raw.lstrip().startswith("#"):
            continue
        stripped = raw.lstrip()
        if stripped.startswith("- ") and key is not None:
            item = _unquote(stripped[2:].strip())
            if not isinstance(data.get(key), list):
                data[key] = []
            data[key].append(item)
            continue
        if ":" in raw:
            k, _, v = raw.partition(":")
            key = k.strip()
            v = v.strip()
            if v == "":
                data[key] = ""  # may be promoted to a block list below
            elif v.startswith("[") and v.endswith("]"):
                inner = v[1:-1].strip()
                data[key] = (
                    [_unquote(x.strip()) for x in inner.split(",") if x.strip()]
                    if inner else []
                )
            else:
                data[key] = _unquote(v)
    return data, body


def extract_wikilinks(body: str):
    return [m.group(1).strip() for m in WIKILINK_RE.finditer(body)]


def tokenize(text: str):
    return [t for t in TOKEN_RE.findall(text.lower())
            if t not in STOPWORDS and len(t) > 1]


class Page:
    __slots__ = ("path", "rel", "stem", "fm", "body", "slug", "type", "title", "summary")

    def __init__(self, path, wiki):
        self.path = path
        self.rel = os.path.relpath(path, wiki)
        self.stem = os.path.splitext(os.path.basename(path))[0]
        with open(path, "r", encoding="utf-8") as fh:
            self.fm, self.body = parse_frontmatter(fh.read())
        self.slug = self.fm.get("slug") or self.stem
        self.type = self.fm.get("type") or ""
        self.title = self.fm.get("title") or self.stem
        self.summary = self.fm.get("summary") or ""


def iter_pages(wiki: str):
    pages_root = os.path.join(wiki, PAGES_DIR)
    if not os.path.isdir(pages_root):
        return
    for root, dirs, files in os.walk(pages_root):
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in sorted(files):
            if name.endswith(".md"):
                yield Page(os.path.join(root, name), wiki)


def load_pages(wiki: str):
    return list(iter_pages(wiki))


def list_source_files(wiki: str):
    src_root = os.path.join(wiki, SOURCES_DIR)
    out = []
    if os.path.isdir(src_root):
        for root, dirs, files in os.walk(src_root):
            dirs[:] = [d for d in dirs if not d.startswith(".")]
            for f in files:
                if not f.startswith("."):
                    out.append(os.path.relpath(os.path.join(root, f), src_root))
    return sorted(out)


def is_wiki(wiki: str) -> bool:
    return os.path.isdir(os.path.join(wiki, PAGES_DIR)) and os.path.isfile(
        os.path.join(wiki, AGENTS_FILE)
    )


def wiki_name(wiki: str) -> str:
    cfg = os.path.join(wiki, TOOL_DIR, "config.json")
    if os.path.isfile(cfg):
        try:
            with open(cfg, "r", encoding="utf-8") as fh:
                name = json.load(fh).get("name")
            if name:
                return name
        except (ValueError, OSError):
            pass
    return os.path.basename(wiki.rstrip("/")) or "wiki"


# --------------------------------------------------------------------------- #
# Pure operations (shared by CLI commands, selftest and the unittest suite)
# --------------------------------------------------------------------------- #

def search_wiki(wiki: str, query: str, k: int = 10):
    """BM25 ranking over page bodies (title tokens boosted). Deterministic."""
    pages = load_pages(wiki)
    docs = [(p, tokenize(p.body) + tokenize(p.title) * TITLE_BOOST) for p in pages]
    n = len(docs)
    q_tokens = tokenize(query)
    if not docs or not q_tokens:
        return []
    df = {}
    for _, toks in docs:
        for t in set(toks):
            df[t] = df.get(t, 0) + 1
    avgdl = sum(len(t) for _, t in docs) / n
    scored = []
    for page, toks in docs:
        if not toks:
            continue
        tf = {}
        for t in toks:
            tf[t] = tf.get(t, 0) + 1
        dl = len(toks)
        score = 0.0
        for qt in q_tokens:
            if qt not in tf:
                continue
            idf = math.log(1 + (n - df[qt] + 0.5) / (df[qt] + 0.5))
            f = tf[qt]
            score += idf * (f * (BM25_K1 + 1)) / (
                f + BM25_K1 * (1 - BM25_B + BM25_B * dl / avgdl))
        if score > 0:
            scored.append((score, page))
    scored.sort(key=lambda sp: (-sp[0], sp[1].slug))
    return [{"slug": p.slug, "title": p.title, "type": p.type, "rel": p.rel,
             "score": round(s, 4), "snippet": _snippet(p.body, q_tokens)}
            for s, p in scored[:k]]


def _snippet(body, query_tokens, width=200):
    text = re.sub(r"\s+", " ", re.sub(r"[#*`>\[\]]", " ", body)).strip()
    low = text.lower()
    for tok in query_tokens:
        idx = low.find(tok)
        if idx != -1:
            start = max(0, idx - width // 3)
            return ("..." if start else "") + text[start:start + width].strip() + "..."
    return text[:width].strip() + ("..." if len(text) > width else "")


def build_catalog(wiki: str):
    catalog = {t: [] for t, _ in INDEX_SECTIONS}
    for page in load_pages(wiki):
        t = page.type if page.type in catalog else "analysis"
        entry = {"slug": page.slug, "title": page.title, "summary": page.summary,
                 "type": page.type, "rel": page.rel}
        if page.type == "source":
            entry["refs"] = len(page.fm.get("sources", []) or [])
        catalog.setdefault(t, []).append(entry)
    for t in catalog:
        catalog[t].sort(key=lambda e: (e["title"].lower(), e["slug"]))
    return catalog


def render_index(wiki: str, catalog) -> str:
    out = [f"# {wiki_name(wiki)} - Index", "",
           "_Generated by `wikikit index rebuild`. Do not edit by hand._", ""]
    for t, heading in INDEX_SECTIONS:
        items = catalog.get(t, [])
        if not items:
            continue
        out.append(f"## {heading}")
        out.append("")
        for e in items:
            line = f"- [[{e['slug']}]]"
            if e["summary"]:
                line += f" - {e['summary']}"
            if t == "source" and e.get("refs"):
                line += f" (refs: {e['refs']})"
            out.append(line)
        out.append("")
    return "\n".join(out).rstrip() + "\n"


def index_drift(wiki: str):
    on_disk = {p.slug for p in load_pages(wiki)}
    path = os.path.join(wiki, INDEX_FILE)
    indexed = set()
    if os.path.isfile(path):
        with open(path, "r", encoding="utf-8") as fh:
            indexed = set(extract_wikilinks(fh.read()))
    return sorted(on_disk - indexed), sorted(indexed - on_disk)


def validate_wiki(wiki: str):
    schema = _load_json_schema(wiki)
    errors, warnings, n = [], [], 0
    for p in load_pages(wiki):
        n += 1
        where = p.rel
        if not p.fm:
            errors.append(f"{where}: no YAML frontmatter")
            continue
        _check_schema(p.fm, schema, where, errors)
        if p.type and p.type not in VALID_TYPES:
            errors.append(f"{where}: invalid type {p.type!r}")
        if p.slug != p.stem:
            errors.append(f"{where}: slug {p.slug!r} != filename {p.stem!r}")
        for datekey in ("created", "updated"):
            val = p.fm.get(datekey)
            if val and not DATE_RE.match(str(val)):
                warnings.append(f"{where}: {datekey} {val!r} not YYYY-MM-DD")
        if not p.summary:
            warnings.append(f"{where}: missing 'summary' (used by index.md)")
        status = p.fm.get("status")
        if status and status not in VALID_STATUS:
            warnings.append(f"{where}: status {status!r} not one of {sorted(VALID_STATUS)}")
    return {"ok": not errors, "pages_checked": n, "errors": errors, "warnings": warnings}


def lint_wiki(wiki: str):
    pages = load_pages(wiki)
    by_slug = {p.slug: p for p in pages}
    inbound = {p.slug: 0 for p in pages}
    broken = []
    for p in pages:
        for target in extract_wikilinks(p.body):
            if target in by_slug:
                inbound[target] += 1
            else:
                broken.append({"page": p.slug, "missing_link": target})

    orphans = sorted(p.slug for p in pages
                     if inbound[p.slug] == 0 and p.type != "overview" and p.slug != "overview")

    stale = []
    cutoff = (_dt.date.today() - _dt.timedelta(days=STALE_DAYS)).isoformat()
    for p in pages:
        upd = str(p.fm.get("updated", ""))
        if p.fm.get("status") == "stale":
            stale.append({"page": p.slug, "reason": "status: stale"})
        elif DATE_RE.match(upd) and upd < cutoff:
            stale.append({"page": p.slug, "reason": f"not updated since {upd}"})

    referenced = set()
    for p in pages:
        if p.type == "source":
            sf = p.fm.get("source_file")
            if isinstance(sf, list):
                referenced.update(sf)
            elif sf:
                referenced.add(sf)
    uncovered_sources = sorted(set(list_source_files(wiki)) - referenced)

    issues = {"orphans": orphans, "broken_links": broken,
              "stale": stale, "uncovered_sources": uncovered_sources}
    total = sum(len(v) for v in issues.values())
    return {"clean": total == 0, "issue_count": total, "pages": len(pages), "issues": issues}


def wiki_stats(wiki: str):
    pages = load_pages(wiki)
    by_type, links = {}, 0
    by_slug = {p.slug for p in pages}
    inbound = {p.slug: 0 for p in pages}
    for p in pages:
        by_type[p.type or "untyped"] = by_type.get(p.type or "untyped", 0) + 1
        for target in extract_wikilinks(p.body):
            links += 1
            if target in by_slug:
                inbound[target] += 1
    entries = read_log_entries(wiki)
    return {"pages": len(pages), "by_type": by_type,
            "source_files": len(list_source_files(wiki)), "links": links,
            "orphans": sum(1 for s, c in inbound.items() if c == 0 and s != "overview"),
            "log_entries": len(entries),
            "last_activity": entries[-1]["header"] if entries else None}


def append_log(wiki, op, title, summary=None, sources=None, pages=None, date=None):
    date = date or today()
    path = os.path.join(wiki, LOG_FILE)
    lines = [f"## [{date}] {op} | {title}", ""]
    if summary:
        lines.append(f"- summary: {summary}")
    if sources is not None:
        lines.append(f"- sources: {sources}")
    if pages:
        lines.append(f"- pages: {', '.join(pages)}")
    entry = "\n".join(lines).rstrip() + "\n"
    prefix = ""
    if os.path.exists(path):
        with open(path, "r", encoding="utf-8") as fh:
            existing = fh.read()
        if existing and not existing.endswith("\n"):
            prefix = "\n"
        prefix += "\n"
    with open(path, "a", encoding="utf-8") as fh:
        fh.write(prefix + entry)
    return {"date": date, "op": op, "title": title, "summary": summary,
            "sources": sources, "pages": pages or []}


def read_log_entries(wiki):
    path = os.path.join(wiki, LOG_FILE)
    if not os.path.isfile(path):
        return []
    with open(path, "r", encoding="utf-8") as fh:
        lines = fh.read().split("\n")
    entries, current = [], None
    for line in lines:
        if LOG_ENTRY_RE.match(line):
            if current is not None:
                entries.append(current)
            current = {"header": line, "_body": []}
        elif current is not None:
            current["_body"].append(line)
    if current is not None:
        entries.append(current)
    for e in entries:
        e["text"] = (e["header"] + "\n" + "\n".join(e.pop("_body")).rstrip()).rstrip()
    return entries


def _load_json_schema(wiki):
    candidates = [os.path.join(wiki, TOOL_DIR, "schema", "frontmatter.schema.json")]
    root = asset_root()
    if root:
        candidates.append(os.path.join(root, "schema", "frontmatter.schema.json"))
    for path in candidates:
        if os.path.isfile(path):
            with open(path, "r", encoding="utf-8") as fh:
                return json.load(fh)
    return None


def _check_schema(fm, schema, where, errors):
    if not schema:
        return
    for key in schema.get("required", []):
        if key not in fm or fm[key] in ("", [], None):
            errors.append(f"{where}: missing required frontmatter '{key}'")
    for key, spec in schema.get("properties", {}).items():
        if key not in fm:
            continue
        val = fm[key]
        expected = spec.get("type")
        if expected == "array" and not isinstance(val, list):
            errors.append(f"{where}: '{key}' should be a list")
        if expected == "string" and isinstance(val, list):
            errors.append(f"{where}: '{key}' should be a string")
        if "enum" in spec and val not in spec["enum"]:
            errors.append(f"{where}: '{key}'={val!r} not one of {spec['enum']}")


# --------------------------------------------------------------------------- #
# Asset discovery + page authoring helpers
# --------------------------------------------------------------------------- #

def asset_root():
    """Locate the directory holding `templates/` and `schema/`.

    Works from the skill (scripts/wikikit -> ../assets) and from the installed
    copy (.wiki/bin/wikikit -> ..).
    """
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (os.path.join(here, "..", "assets"), os.path.join(here, "..")):
        cand = os.path.abspath(cand)
        if os.path.isdir(os.path.join(cand, "templates")):
            return cand
    return None


def render(text: str, **subs) -> str:
    for key, val in subs.items():
        text = text.replace("{{%s}}" % key, val)
    return text


def write_page(wiki, ptype, slug, title, summary, body="", **extra):
    """Author a page file. Used by selftest/tests and available for scripting."""
    subdir = TYPE_DIRS.get(ptype, "topics")
    date = today()
    fm = [f"title: {title}", f"type: {ptype}", f"slug: {slug}",
          f"created: {date}", f"updated: {date}", f"summary: {summary}",
          "status: active"]
    for k, v in extra.items():
        fm.append(f"{k}: {v}")
    content = "---\n" + "\n".join(fm) + "\n---\n\n# " + title + "\n\n" + body + "\n"
    path = os.path.join(wiki, PAGES_DIR, subdir, slug + ".md")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write(content)
    return path


def scaffold_wiki(wiki, name=None, upgrade=False):
    """Create / upgrade a wiki. Returns {created, updated, mode, name}."""
    wiki = os.path.abspath(wiki)
    assets = asset_root()
    if assets is None:
        raise RuntimeError("could not locate bundled templates/schema next to wikikit")
    tmpl_dir = os.path.join(assets, "templates")
    schema_dir = os.path.join(assets, "schema")
    created, updated = [], []

    def mkdir(rel):
        path = os.path.join(wiki, rel)
        if not os.path.isdir(path):
            os.makedirs(path, exist_ok=True)
            created.append(rel + "/")

    def install(src, rel):
        dst = os.path.join(wiki, rel)
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        existed = os.path.exists(dst)
        shutil.copyfile(src, dst)
        (updated if existed else created).append(rel)
        return dst

    def write_if_absent(rel, content):
        path = os.path.join(wiki, rel)
        if os.path.exists(path):
            return
        os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(content)
        created.append(rel)

    mkdir(os.path.join(TOOL_DIR, "bin"))
    mkdir(os.path.join(TOOL_DIR, "schema"))
    mkdir(os.path.join(TOOL_DIR, "templates"))
    tool = install(os.path.abspath(__file__), os.path.join(TOOL_DIR, "bin", "wikikit"))
    os.chmod(tool, os.stat(tool).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)
    for fn in sorted(os.listdir(schema_dir)):
        install(os.path.join(schema_dir, fn), os.path.join(TOOL_DIR, "schema", fn))
    for fn in sorted(os.listdir(tmpl_dir)):
        install(os.path.join(tmpl_dir, fn), os.path.join(TOOL_DIR, "templates", fn))

    if upgrade:
        return {"wiki": wiki, "mode": "upgrade", "created": created, "updated": updated}

    name = name or os.path.basename(wiki.rstrip("/")) or "wiki"
    date = today()
    mkdir(SOURCES_DIR)
    mkdir(PAGES_DIR)
    for sub in TYPE_DIRS.values():
        mkdir(os.path.join(PAGES_DIR, sub))

    cfg_path = os.path.join(wiki, TOOL_DIR, "config.json")
    if not os.path.exists(cfg_path):
        with open(cfg_path, "w", encoding="utf-8") as fh:
            json.dump({"name": name, "created": date}, fh, indent=2)
        created.append(os.path.join(TOOL_DIR, "config.json"))

    def tmpl(fname):
        with open(os.path.join(tmpl_dir, fname), "r", encoding="utf-8") as fh:
            return fh.read()

    write_if_absent(AGENTS_FILE, render(tmpl("AGENTS.md"), WIKI_NAME=name, DATE=date))
    write_if_absent(INDEX_FILE, render(tmpl("index.md"), WIKI_NAME=name, DATE=date))
    write_if_absent(LOG_FILE, render(tmpl("log.md"), WIKI_NAME=name, DATE=date))
    write_if_absent(SINGLETON_PAGES["overview"],
                    render(tmpl("overview.md"), WIKI_NAME=name, DATE=date))
    write_if_absent(os.path.join(SOURCES_DIR, ".gitkeep"), "")
    append_log(wiki, "init", f"initialized wiki '{name}'",
               summary="scaffolded by wikikit", date=date)
    return {"wiki": wiki, "mode": "init", "name": name, "created": created, "updated": updated}


# --------------------------------------------------------------------------- #
# Output helpers
# --------------------------------------------------------------------------- #

def emit(payload, as_json: bool, text_fn):
    if as_json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        text_fn(payload)


def fail(msg: str, code: int = 2):
    print(f"wikikit: error: {msg}", file=sys.stderr)
    raise SystemExit(code)


def require_wiki(wiki: str):
    if not is_wiki(wiki):
        fail(f"{wiki!r} is not an initialized wiki (missing {AGENTS_FILE} or "
             f"{PAGES_DIR}/). Run `wikikit init {wiki}` first.")


# --------------------------------------------------------------------------- #
# CLI command wrappers
# --------------------------------------------------------------------------- #

def cmd_init(args):
    try:
        result = scaffold_wiki(args.dir, name=args.name, upgrade=args.upgrade)
    except RuntimeError as exc:
        fail(str(exc))
    if result["mode"] == "upgrade":
        emit(result, args.json, lambda r: print(
            f"Upgraded toolkit in {r['wiki']}\n  refreshed: "
            f"{', '.join(r['updated']) or '(none)'}"))
    else:
        emit(result, args.json, lambda r: print(
            f"Initialized wiki '{r['name']}' at {r['wiki']}\n"
            f"  created {len(r['created'])} paths"))


def cmd_search(args):
    require_wiki(args.wiki)
    results = search_wiki(args.wiki, args.query, args.k)

    def show(_):
        print(f"results for {args.query!r}:")
        if not results:
            print("  (no matches)")
        for x in results:
            print(f"  [{x['score']:.3f}] {x['slug']} ({x['type']}) - {x['snippet'][:80]}")
    emit({"query": args.query, "results": results}, args.json, show)


def cmd_validate(args):
    require_wiki(args.wiki)
    r = validate_wiki(args.wiki)

    def show(res):
        print(f"validate: {res['pages_checked']} pages, {len(res['errors'])} errors, "
              f"{len(res['warnings'])} warnings")
        for e in res["errors"]:
            print("  ERROR " + e)
        for w in res["warnings"]:
            print("  warn  " + w)
    emit(r, args.json, show)
    if not r["ok"]:
        raise SystemExit(1)


def cmd_lint(args):
    require_wiki(args.wiki)
    r = lint_wiki(args.wiki)

    def show(res):
        print(f"lint: {res['pages']} pages, {res['issue_count']} issues")
        for k, v in res["issues"].items():
            if v:
                print(f"  {k}: {v}")
        if res["clean"]:
            print("  wiki is healthy")
    emit(r, args.json, show)
    if args.strict and r["issue_count"]:
        raise SystemExit(1)


def cmd_stats(args):
    require_wiki(args.wiki)
    r = wiki_stats(args.wiki)
    emit(r, args.json, lambda res: print(
        f"pages={res['pages']} sources={res['source_files']} links={res['links']} "
        f"orphans={res['orphans']} log_entries={res['log_entries']}\n"
        f"by_type={res['by_type']}"))


def cmd_index_rebuild(args):
    require_wiki(args.wiki)
    catalog = build_catalog(args.wiki)
    with open(os.path.join(args.wiki, INDEX_FILE), "w", encoding="utf-8") as fh:
        fh.write(render_index(args.wiki, catalog))
    total = sum(len(v) for v in catalog.values())
    emit({"pages": total, "by_type": {k: len(v) for k, v in catalog.items() if v}},
         args.json, lambda r: print(f"index rebuilt: {total} pages cataloged"))


def cmd_index_check(args):
    require_wiki(args.wiki)
    missing, extra = index_drift(args.wiki)
    ok = not missing and not extra
    emit({"ok": ok, "missing_from_index": missing, "extra_in_index": extra}, args.json,
         lambda r: print("index OK" if ok else
                         f"index drift: {len(missing)} missing, {len(extra)} extra "
                         f"(run `wikikit index rebuild`)"))
    if not ok:
        raise SystemExit(1)


def cmd_log_add(args):
    require_wiki(args.wiki)
    pages = [p.strip() for p in args.pages.split(",")] if args.pages else None
    entry = append_log(args.wiki, args.op, args.title, summary=args.summary,
                       sources=args.sources, pages=pages, date=args.date)
    emit(entry, args.json,
         lambda e: print(f"logged: [{e['date']}] {e['op']} | {e['title']}"))


def cmd_log_tail(args):
    require_wiki(args.wiki)
    entries = read_log_entries(args.wiki)[-args.n:]
    emit({"count": len(entries), "entries": entries}, args.json,
         lambda r: print("\n\n".join(e["text"] for e in r["entries"]) or "(no log entries)"))


def cmd_selftest(args):
    checks = []

    def check(name, cond):
        checks.append({"name": name, "ok": bool(cond)})

    tmp = tempfile.mkdtemp(prefix="wikikit-selftest-")
    try:
        wiki = os.path.join(tmp, "demo")
        scaffold_wiki(wiki, name="demo")
        check("init creates AGENTS.md", os.path.isfile(os.path.join(wiki, AGENTS_FILE)))
        check("init installs toolkit",
              os.path.isfile(os.path.join(wiki, TOOL_DIR, "bin", "wikikit")))
        check("init creates pages dirs",
              os.path.isdir(os.path.join(wiki, PAGES_DIR, "entities")))

        write_page(wiki, "entity", "ada-lovelace", "Ada Lovelace", "First programmer.",
                   body="Worked with [[charles-babbage]] on the engine.")
        write_page(wiki, "entity", "charles-babbage", "Charles Babbage",
                   "Inventor of the analytical engine.",
                   body="Collaborated with [[ada-lovelace]].")
        write_page(wiki, "concept", "analytical-engine", "Analytical Engine",
                   "A proposed mechanical general-purpose computer.",
                   body="Designed by [[charles-babbage]]. Programmed by [[ada-lovelace]].")
        with open(os.path.join(wiki, SOURCES_DIR, "note.txt"), "w") as fh:
            fh.write("a raw source about computing pioneers")

        cat = build_catalog(wiki)
        with open(os.path.join(wiki, INDEX_FILE), "w") as fh:
            fh.write(render_index(wiki, cat))
        with open(os.path.join(wiki, INDEX_FILE)) as fh:
            idx = fh.read()
        check("index lists ada-lovelace", "[[ada-lovelace]]" in idx)
        check("index lists analytical-engine", "[[analytical-engine]]" in idx)
        check("index check is clean", index_drift(wiki) == ([], []))

        results = search_wiki(wiki, "engine babbage", 5)
        check("search returns matches", len(results) >= 1)
        check("search ranks a relevant page first",
              results and results[0]["slug"] in ("charles-babbage", "analytical-engine"))

        check("validate passes on good pages", validate_wiki(wiki)["ok"] is True)

        bad = os.path.join(wiki, PAGES_DIR, "entities", "broken.md")
        with open(bad, "w") as fh:
            fh.write("---\ntitle: Broken\ntype: bogus\nslug: not-broken\n---\nbody\n")
        check("validate catches bad type + slug mismatch",
              len(validate_wiki(wiki)["errors"]) >= 2)
        os.remove(bad)

        write_page(wiki, "concept", "lonely", "Lonely", "Nobody links here.",
                   body="I reference [[ghost-page]] that does not exist.")
        lint = lint_wiki(wiki)
        check("lint finds orphan", "lonely" in lint["issues"]["orphans"])
        check("lint finds broken link",
              any(b["missing_link"] == "ghost-page" for b in lint["issues"]["broken_links"]))
        check("lint finds uncovered source", "note.txt" in lint["issues"]["uncovered_sources"])

        append_log(wiki, "query", "selftest query", summary="checking the log")
        entries = read_log_entries(wiki)
        check("log has init + query entries", len(entries) >= 2)
        check("log entry has grep-able prefix", entries[-1]["header"].startswith("## ["))
    finally:
        shutil.rmtree(tmp, ignore_errors=True)

    ok = all(c["ok"] for c in checks)
    result = {"ok": ok, "passed": sum(c["ok"] for c in checks),
              "total": len(checks), "checks": checks}

    def show(r):
        print(f"selftest: {r['passed']}/{r['total']} checks passed")
        for c in r["checks"]:
            print(f"  {'PASS' if c['ok'] else 'FAIL'}  {c['name']}")
    emit(result, args.json, show)
    if not ok:
        raise SystemExit(1)


# --------------------------------------------------------------------------- #
# Argument parsing
# --------------------------------------------------------------------------- #

def build_parser():
    p = argparse.ArgumentParser(prog="wikikit", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="command", required=True)

    def add_json(sp):
        sp.add_argument("--json", action="store_true", help="machine-readable JSON output")

    sp = sub.add_parser("init", help="scaffold a new wiki (or --upgrade the toolkit)")
    sp.add_argument("dir", help="wiki directory")
    sp.add_argument("--name", help="display name (default: directory name)")
    sp.add_argument("--upgrade", action="store_true",
                    help="refresh only the .wiki/ toolkit, schema and templates")
    add_json(sp)
    sp.set_defaults(func=cmd_init)

    sp = sub.add_parser("search", help="BM25 keyword search over wiki pages")
    sp.add_argument("wiki")
    sp.add_argument("query")
    sp.add_argument("-k", type=int, default=10, help="max results (default 10)")
    add_json(sp)
    sp.set_defaults(func=cmd_search)

    sp = sub.add_parser("validate", help="validate page frontmatter against the schema")
    sp.add_argument("wiki")
    add_json(sp)
    sp.set_defaults(func=cmd_validate)

    sp = sub.add_parser("lint", help="health-check (orphans, broken links, stale, gaps)")
    sp.add_argument("wiki")
    sp.add_argument("--strict", action="store_true", help="exit non-zero on any issue")
    add_json(sp)
    sp.set_defaults(func=cmd_lint)

    sp = sub.add_parser("stats", help="summary counts for the wiki")
    sp.add_argument("wiki")
    add_json(sp)
    sp.set_defaults(func=cmd_stats)

    sp = sub.add_parser("selftest", help="run an end-to-end smoke test in a temp wiki")
    add_json(sp)
    sp.set_defaults(func=cmd_selftest)

    sp = sub.add_parser("index", help="rebuild or check index.md")
    isub = sp.add_subparsers(dest="index_cmd", required=True)
    r = isub.add_parser("rebuild", help="regenerate index.md from page frontmatter")
    r.add_argument("wiki")
    add_json(r)
    r.set_defaults(func=cmd_index_rebuild)
    c = isub.add_parser("check", help="verify index.md matches pages on disk")
    c.add_argument("wiki")
    add_json(c)
    c.set_defaults(func=cmd_index_check)

    sp = sub.add_parser("log", help="append to or read the chronological log")
    lsub = sp.add_subparsers(dest="log_cmd", required=True)
    a = lsub.add_parser("add", help="append a log entry")
    a.add_argument("wiki")
    a.add_argument("--op", required=True,
                   choices=["ingest", "query", "lint", "init", "note"])
    a.add_argument("--title", required=True)
    a.add_argument("--summary")
    a.add_argument("--sources", type=int)
    a.add_argument("--pages", help="comma-separated page slugs touched")
    a.add_argument("--date", help="YYYY-MM-DD (default: today)")
    add_json(a)
    a.set_defaults(func=cmd_log_add)
    t = lsub.add_parser("tail", help="print the last N log entries")
    t.add_argument("wiki")
    t.add_argument("-n", type=int, default=5)
    add_json(t)
    t.set_defaults(func=cmd_log_tail)

    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    main()
